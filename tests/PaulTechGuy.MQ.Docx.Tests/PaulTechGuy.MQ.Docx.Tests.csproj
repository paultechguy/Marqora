<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The Word exporter's tests. Structural rather than golden-file: a .docx is a zip of XML
    parts, and a byte comparison would fail on a timestamp while saying nothing about whether
    a heading came out as Heading 1. These open the written document with the SDK and assert
    on the tree.

    The validator test is the one that earns its keep. WordprocessingML is a schema sequence,
    not a bag of elements, and Word answers a wrong child order by offering to repair the
    file rather than by saying what is wrong - so an ordering mistake is invisible until
    someone opens the document somewhere else.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>PaulTechGuy.MQ.Docx.Tests</RootNamespace>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Shouldly" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\PaulTechGuy.MQ.Docx\PaulTechGuy.MQ.Docx.csproj" />
  </ItemGroup>

</Project>
