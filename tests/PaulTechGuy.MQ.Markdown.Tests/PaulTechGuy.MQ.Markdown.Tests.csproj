<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The masker's promise is that a masked line is the same length as the line it came from,
    because every offset the spell engine reports is an offset into the original. Most of what
    is tested here is that promise holding under each rule in turn.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>PaulTechGuy.MQ.Markdown.Tests</RootNamespace>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Shouldly" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\PaulTechGuy.MQ.Markdown\PaulTechGuy.MQ.Markdown.csproj" />
  </ItemGroup>

</Project>
