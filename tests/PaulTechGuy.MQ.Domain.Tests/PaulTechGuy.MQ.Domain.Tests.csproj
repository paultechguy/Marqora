<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Domain holds the facts the app reasons about rather than anything it does, so most of it
    is records with nothing to test. OutlineNavigation is the exception: it answers questions
    about a document, and the outline panel is the wrong place to find out it answers them
    wrongly.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>PaulTechGuy.MQ.Domain.Tests</RootNamespace>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Shouldly" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\PaulTechGuy.MQ.Domain\PaulTechGuy.MQ.Domain.csproj" />
  </ItemGroup>

</Project>
