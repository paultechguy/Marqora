<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The formatter's tests. It works on lines rather than on a parsed tree, so every rule is a
    small state machine reading one line at a time and deciding what the ones before it meant
    - which is exactly the shape of code that passes a hand-check and then gets a nested list
    or a loose one wrong.

    Ordered numbering is the first rule to be covered, because it was rewritten to decide over
    a whole run rather than a line at a time and there was nothing standing under it.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>PaulTechGuy.MQ.Formatting.Tests</RootNamespace>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Shouldly" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\PaulTechGuy.MQ.Formatting\PaulTechGuy.MQ.Formatting.csproj" />
  </ItemGroup>

</Project>
