<Project Sdk="Microsoft.NET.Sdk">

  <!--
    marqora-cli, run the two ways a user can meet it: in-process, through CliApp with output
    streams of the test's own, which is fast and is most of the suite; and as the built
    executable, for what only a real process has - signals, shells, redirected handles, a kill
    part way through a write.

    The same target framework and platform as the CLI, which references WebView2's WinRT
    projection and is built for x64 alone.

    The projection asked for here too. Without it this output gets the package's classic .NET
    Microsoft.Web.WebView2.Core.dll, where the CLI's has the native WinRT component of the same
    name, and an export run in-process found "class not registered" for a runtime that is there.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>PaulTechGuy.MQ.Cli.Tests</RootNamespace>
    <OutputType>Exe</OutputType>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>enable</Nullable>
    <WebView2EnableCsWinRTProjection>true</WebView2EnableCsWinRTProjection>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Shouldly" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\PaulTechGuy.MQ.Cli\PaulTechGuy.MQ.Cli.csproj" />
    <ProjectReference Include="..\..\src\PaulTechGuy.MQ.Domain\PaulTechGuy.MQ.Domain.csproj" />
  </ItemGroup>

</Project>
