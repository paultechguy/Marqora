<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The export code shared by the app and marqora-cli (CLI-TST-02). On the Windows target so the
    shrinker can be tested with the real Windows Imaging resizer rather than a stand-in: whether a
    picture is really made smaller is the thing worth knowing.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>PaulTechGuy.MQ.Exporting.Tests</RootNamespace>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Shouldly" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\PaulTechGuy.MQ.Exporting\PaulTechGuy.MQ.Exporting.csproj" />
    <ProjectReference Include="..\..\src\PaulTechGuy.MQ.Imaging\PaulTechGuy.MQ.Imaging.csproj" />
  </ItemGroup>

</Project>
