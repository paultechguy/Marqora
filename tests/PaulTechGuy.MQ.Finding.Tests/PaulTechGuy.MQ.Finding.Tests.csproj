<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The finder has no UI to check it, so these tests are the whole safety net: the window is
    only ever as right as the line and column numbers reported here.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>PaulTechGuy.MQ.Finding.Tests</RootNamespace>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Shouldly" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\PaulTechGuy.MQ.Finding\PaulTechGuy.MQ.Finding.csproj" />
  </ItemGroup>

</Project>
