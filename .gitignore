# Build output
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/
artifacts/

# Visual Studio
.vs/
*.user
*.suo
*.userosscache
*.sln.docstates
*.rsuser

# Rider / VS Code
.idea/
.vscode/
*.DotSettings.user

# NuGet
*.nupkg
*.snupkg
packages/
!packages/build/

# Downloaded third-party web assets (restored by build/Get-WebAssets.ps1)
webshell/vendor/

# OS
Thumbs.db
desktop.ini

# Local debug profiles (per-developer; e.g. WebView2 remote debugging port)
**/Properties/launchSettings.json

# Local AI assistant instructions (kept on disk, not published)
CLAUDE.md
.claude/

# The CLI export baseline: exports made from the app, kept out of git and proved unchanged by the
# committed MANIFEST.sha256 (tests/baselines/cli/README.md).
tests/baselines/cli/*
!tests/baselines/cli/README.md
!tests/baselines/cli/MANIFEST.sha256
!tests/baselines/cli/inputs/

# Fresh sets of the same exports, made to be compared with the baseline by
# build/Compare-ExportBaseline.ps1, one folder per occasion, with its report beside it.
tests/baselines/fresh/
