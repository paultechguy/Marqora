<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The markdown beautifier. Pure text in, text out: no UI, no I/O and no async, so it can
    be exercised straight from a test project by handing it a string and asserting on the
    result.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>PaulTechGuy.MQ.Formatting</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PaulTechGuy.MQ.Abstractions\PaulTechGuy.MQ.Abstractions.csproj" />
    <ProjectReference Include="..\PaulTechGuy.MQ.Domain\PaulTechGuy.MQ.Domain.csproj" />

    <!--
      For HeadingScanner and the protected-line scan under it. The heading rewriter must skip
      fences and front matter exactly as the formatter's own line classifier does, and the
      foundation project is where that knowledge already lives in read-only form.
    -->
    <ProjectReference Include="..\PaulTechGuy.MQ.Markdown\PaulTechGuy.MQ.Markdown.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>

</Project>
