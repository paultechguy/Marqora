<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The WinUI 3 shell. This project owns windows, view models and the WebView bridge,
    and nothing else: all behaviour it needs comes in through Abstractions via DI.
  -->

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>PaulTechGuy.MQ.App</RootNamespace>
    <AssemblyName>Marqora</AssemblyName>
    <UseWinUI>true</UseWinUI>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <EnableMsixTooling>false</EnableMsixTooling>
  </PropertyGroup>

  <PropertyGroup Label="Deployment">
    <!--
      Unpackaged: the build produces a plain folder that can be copied anywhere. No MSIX,
      no developer certificate.
    -->
    <WindowsPackageType>None</WindowsPackageType>

    <!-- Carrying the Windows App SDK in the output removes the runtime prerequisite. -->
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>

    <!--
      The runtime identifier, self-contained Release and ReadyToRun live in build\Publish.props,
      imported below and by marqora-cli, which publishes into the same folder.
    -->

    <!-- The WinUI XAML compiler emits its own entry point; Program.cs replaces it. -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>

  <!-- How it publishes, shared with marqora-cli: runtime identifier, self-contained, ReadyToRun. -->
  <Import Project="..\..\build\Publish.props" />

  <ItemGroup>
    <ProjectReference Include="..\PaulTechGuy.MQ.Abstractions\PaulTechGuy.MQ.Abstractions.csproj" />
    <ProjectReference Include="..\PaulTechGuy.MQ.Domain\PaulTechGuy.MQ.Domain.csproj" />
    <ProjectReference Include="..\PaulTechGuy.MQ.Analysis\PaulTechGuy.MQ.Analysis.csproj" />
    <ProjectReference Include="..\PaulTechGuy.MQ.Docx\PaulTechGuy.MQ.Docx.csproj" />
    <ProjectReference Include="..\PaulTechGuy.MQ.Editing\PaulTechGuy.MQ.Editing.csproj" />
    <ProjectReference Include="..\PaulTechGuy.MQ.Exporting\PaulTechGuy.MQ.Exporting.csproj" />
    <ProjectReference Include="..\PaulTechGuy.MQ.Finding\PaulTechGuy.MQ.Finding.csproj" />
    <ProjectReference Include="..\PaulTechGuy.MQ.Folio\PaulTechGuy.MQ.Folio.csproj" />
    <ProjectReference Include="..\PaulTechGuy.MQ.Formatting\PaulTechGuy.MQ.Formatting.csproj" />
    <ProjectReference Include="..\PaulTechGuy.MQ.Imaging\PaulTechGuy.MQ.Imaging.csproj" />
    <ProjectReference Include="..\PaulTechGuy.MQ.Markdown\PaulTechGuy.MQ.Markdown.csproj" />
    <ProjectReference Include="..\PaulTechGuy.MQ.Repositories\PaulTechGuy.MQ.Repositories.csproj" />
    <ProjectReference Include="..\PaulTechGuy.MQ.Rendering\PaulTechGuy.MQ.Rendering.csproj" />
    <ProjectReference Include="..\PaulTechGuy.MQ.Services\PaulTechGuy.MQ.Services.csproj" />
    <ProjectReference Include="..\PaulTechGuy.MQ.Spelling\PaulTechGuy.MQ.Spelling.csproj" />
    <ProjectReference Include="..\PaulTechGuy.MQ.Themes\PaulTechGuy.MQ.Themes.csproj" />
    <ProjectReference Include="..\PaulTechGuy.MQ.WebRender\PaulTechGuy.MQ.WebRender.csproj" />
  </ItemGroup>

  <!--
    Individual Windows App SDK components rather than the metapackage, which would also
    bring in the AI, ML and Widgets payloads. See Directory.Packages.props.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK.Base" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Foundation" />
    <PackageReference Include="Microsoft.WindowsAppSDK.InteractiveExperiences" />
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" />
    <PackageReference Include="Microsoft.WindowsAppSDK.DWrite" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Runtime" />
    <PackageReference Include="Microsoft.Web.WebView2" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Extensions.Hosting" />
    <PackageReference Include="Serilog.Settings.Configuration" />
    <PackageReference Include="Serilog.Sinks.Async" />
    <PackageReference Include="Serilog.Sinks.Debug" />
    <PackageReference Include="Serilog.Sinks.File" />
  </ItemGroup>

  <PropertyGroup>
    <!--
      Sets the icon on the executable itself, which is what Explorer and the taskbar read.
      Rebuilt from MarqoraLogo.png by build\New-AppIcon.ps1; it is not drawn by hand.
    -->
    <ApplicationIcon>Assets\MarqoraLogo.ico</ApplicationIcon>
  </PropertyGroup>

  <!--
    MarqoraLogo.svg is the artwork master and deliberately does not ship: it is a CorelDRAW
    export, and Direct2D reads only a subset of SVG, so what the app draws comes from the
    PNG instead. See AppImages.
  -->
  <!--
    Welcome to Marqora.md is the stock document opened on the first run of each new release.
    It ships beside the executable and is copied into the user's data folder before it is
    opened, so this master is never the file being edited. See WelcomeDocumentService.
  -->
  <ItemGroup>
    <Content Include="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\MarqoraLogo.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\MarqoraLogo.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\Welcome to Marqora.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    marqora-cli's manual, its recipes and the tour folder the manual sends the reader to, in a
    docs folder beside the executable, laid out as they are in the repository so the links
    between them still lead somewhere. Help, Command Line Manual opens the first; somebody in
    a terminal finds them beside marqora-cli.exe, and its help says so. The masters are the
    repository's own, so there is one copy to keep up to date.
  -->
  <ItemGroup>
    <Content Include="..\..\docs\CLI.md" Link="docs\CLI.md" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\docs\CLI-Recipes.md" Link="docs\CLI-Recipes.md" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\docs\cli-tour\**\*" LinkBase="docs\cli-tour" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    The preview shell and its vendor bundle, copied to Assets\web next to the executable. Shared
    with marqora-cli, which hosts the same shell; the file says why it is done this way.
  -->
  <Import Project="..\..\build\WebAssets.targets" />

  <!--
    WinUI ships the strings for its built-in controls, right-click menus and screen-reader
    announcements as .mui resource files, one folder per language: 86 folders and 172 files
    for an app whose own text is English only.

    English is itself a .mui rather than being baked into Microsoft.ui.xaml.dll, so en-us
    and en-GB must survive; dropping every folder would leave the stock controls with no
    strings at all. On any other system language the controls fall back to English, which
    matches the rest of the app.

    The files are filtered out of the copy list rather than deleted afterwards, so an
    incremental build does not copy them only to remove them again.
  -->
  <!--
    The SDK builds its self-contained payload list inside
    AddMicrosoftWindowsAppSDKPayloadFilesFromComponents and subtracts
    MicrosoftWindowsAppSDKFilesExcluded from it. That item exists purely for consumers to
    populate, which makes it the supported way to drop files rather than deleting them from
    the output afterwards.

    NativePlatform comes from GetWindowsAppSDKNativePlatform, so this target takes the same
    dependency in order to glob the right architecture folder.
  -->
  <Target Name="TrimWinUILanguageResources"
          BeforeTargets="AddMicrosoftWindowsAppSDKPayloadFilesFromComponents"
          DependsOnTargets="GetWindowsAppSDKNativePlatform">
    <ItemGroup>
      <_MarqoraMuiFile
          Include="%(WindowsAppSdkComponentPackages.Identity)runtimes-framework\win-$(NativePlatform)\native\**\*.mui" />

      <MicrosoftWindowsAppSDKFilesExcluded
          Include="@(_MarqoraMuiFile)"
          Condition="!$([System.String]::Copy('%(Identity)').Contains('\en-us\'))
                     and !$([System.String]::Copy('%(Identity)').Contains('\en-GB\'))" />
    </ItemGroup>
  </Target>

  <!--
    A folder publish drops two build outputs that WinUI needs at run time: the project's own
    resource index, which is what resolves every ms-appx:/// URI, and App.xbf, the compiled
    App.xaml. Without them the first InitializeComponent throws
    "Cannot locate resource from 'ms-appx:///Views/MainWindow.xaml'" and the process dies
    before a window appears - with no clue in the publish folder as to why.

    They are carried into the publish folder by the MSIX packaging targets, which an
    unpackaged app does not import, so they are added to the publish list by hand. Naming
    the files rather than globing a directory means a publish fails loudly if either one
    ever stops being produced, instead of shipping a folder that cannot start.
  -->
  <Target Name="PublishWinUIResources" AfterTargets="ComputeFilesToPublish">
    <ItemGroup>
      <_MarqoraRuntimeResource Include="$(TargetDir)$(TargetName).pri" />
      <_MarqoraRuntimeResource Include="$(TargetDir)App.xbf" />

      <ResolvedFileToPublish Include="@(_MarqoraRuntimeResource)"
                             RelativePath="%(Filename)%(Extension)"
                             CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>

</Project>
