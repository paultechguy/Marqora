<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        ================================================================================
        Every menu in Marqora is styled from this file, and only from this file.
        ================================================================================

        There are four places a menu appears:

          1. the header menu bar and its flyouts   - MainWindow.xaml
          2. the source pane's right-click menu    - MainWindow.xaml, SourceContextMenu
          3. the preview pane's right-click menu   - MainWindow.xaml, PreviewContextMenu
          4. the diagram and cheatsheet windows    - built in code, same MenuFlyout type

        All four are WinUI MenuFlyouts. They used to be three different things: a WinUI
        menu bar, Monaco's own DOM menu drawn inside the WebView, and Chromium's native
        context menu - which followed Edge's dark mode rather than the app's theme and so
        appeared dark in a light window. The two web-drawn menus were switched off and
        replaced by real flyouts the host puts on screen, precisely so that this file can
        be the only place their appearance is decided.

        Change a value here and every menu in the app follows.

        HOW IT IS PUT TOGETHER

        Two mechanisms, because a menu's appearance comes from two places.

        Anything a Style can set - font, size, padding, row height, the presenter's
        background and border - is set by the implicit styles at the bottom. They are
        BasedOn the framework's own default styles, so only the named properties change
        and the control templates stay stock.

        The rest lives inside those templates, in visual states this file cannot reach:
        the hover and pressed fills, the disabled text, the accelerator text, the
        separator line. Templates read those through named theme resources, so the
        overrides in the theme dictionaries below point the framework's keys at Marqora's
        own tokens. Same effect, opposite direction.

        Colors are written out rather than borrowed with a StaticResource alias from the
        framework's palette. An alias inside a theme dictionary is resolved once, when the
        dictionary is parsed, against whichever theme happened to be active at the time -
        so a light-theme alias can end up holding a dark-theme brush. Literal values
        cannot drift that way. They are Fluent's own values for Windows 11, so the menus
        look stock until someone here decides otherwise. App.xaml states its accent the
        same way and for the same reason.

        ORDERING NOTE: this dictionary must be merged AFTER XamlControlsResources, or
        every key the framework also defines wins over the one here. See App.xaml.
    -->

    <ResourceDictionary.ThemeDictionaries>

        <!-- ============================================================ light theme -->

        <ResourceDictionary x:Key="Light">

            <!--
                THE TOKENS. These eight brushes are what a menu is made of. Everything
                below them is plumbing that points the framework at these values.

                The menu surface: an acrylic mixed to Fluent's in-app recipe, which is
                what a stock Windows 11 menu sits on. For a flat menu, replace this one
                element with a solid brush and all four menus go solid at once:

                    <SolidColorBrush x:Key="MqMenuBackgroundBrush" Color="#FFF9F9F9" />
            -->
            <AcrylicBrush x:Key="MqMenuBackgroundBrush"
                          TintColor="#FCFCFC"
                          TintOpacity="0.0"
                          TintLuminosityOpacity="0.85"
                          FallbackColor="#F9F9F9" />

            <SolidColorBrush x:Key="MqMenuBorderBrush" Color="#0F000000" />
            <SolidColorBrush x:Key="MqMenuForegroundBrush" Color="#E4000000" />
            <SolidColorBrush x:Key="MqMenuForegroundDisabledBrush" Color="#5C000000" />

            <!-- Shortcut text, which reads as a footnote to the item it belongs to. -->
            <SolidColorBrush x:Key="MqMenuAcceleratorForegroundBrush" Color="#9E000000" />

            <!-- The pointer. Deliberately a tint of the surface, not the accent. -->
            <SolidColorBrush x:Key="MqMenuItemHoverBrush" Color="#0A000000" />
            <SolidColorBrush x:Key="MqMenuItemPressedBrush" Color="#06000000" />

            <SolidColorBrush x:Key="MqMenuSeparatorBrush" Color="#0F000000" />

            <!--
                The framework's keys, pointed at the tokens above.

                These are same-dictionary aliases - the target is defined a few lines up -
                so the parse-time resolution described in the header is not a hazard here.
            -->

            <!-- Menu surface. -->
            <StaticResource x:Key="MenuFlyoutPresenterBackground" ResourceKey="MqMenuBackgroundBrush" />
            <StaticResource x:Key="MenuFlyoutPresenterBorderBrush" ResourceKey="MqMenuBorderBrush" />
            <StaticResource x:Key="MenuFlyoutSeparatorThemeBrush" ResourceKey="MqMenuSeparatorBrush" />

            <!-- Items: text. -->
            <StaticResource x:Key="MenuFlyoutItemForeground" ResourceKey="MqMenuForegroundBrush" />
            <StaticResource x:Key="MenuFlyoutItemForegroundPointerOver" ResourceKey="MqMenuForegroundBrush" />
            <StaticResource x:Key="MenuFlyoutItemForegroundPressed" ResourceKey="MqMenuForegroundBrush" />
            <StaticResource x:Key="MenuFlyoutItemForegroundDisabled" ResourceKey="MqMenuForegroundDisabledBrush" />

            <!-- Items: fill. Left transparent at rest so the surface shows through. -->
            <StaticResource x:Key="MenuFlyoutItemBackgroundPointerOver" ResourceKey="MqMenuItemHoverBrush" />
            <StaticResource x:Key="MenuFlyoutItemBackgroundPressed" ResourceKey="MqMenuItemPressedBrush" />

            <!-- Items: the tick on a ToggleMenuFlyoutItem. -->
            <StaticResource x:Key="MenuFlyoutItemCheckGlyphForeground" ResourceKey="MqMenuForegroundBrush" />
            <StaticResource x:Key="MenuFlyoutItemCheckGlyphForegroundPointerOver" ResourceKey="MqMenuForegroundBrush" />
            <StaticResource x:Key="MenuFlyoutItemCheckGlyphForegroundPressed" ResourceKey="MqMenuForegroundBrush" />
            <StaticResource x:Key="MenuFlyoutItemCheckGlyphForegroundDisabled" ResourceKey="MqMenuForegroundDisabledBrush" />

            <!-- Items: the Ctrl+S half of the row. -->
            <StaticResource x:Key="MenuFlyoutItemKeyboardAcceleratorTextForeground"
                            ResourceKey="MqMenuAcceleratorForegroundBrush" />
            <StaticResource x:Key="MenuFlyoutItemKeyboardAcceleratorTextForegroundPointerOver"
                            ResourceKey="MqMenuAcceleratorForegroundBrush" />
            <StaticResource x:Key="MenuFlyoutItemKeyboardAcceleratorTextForegroundPressed"
                            ResourceKey="MqMenuAcceleratorForegroundBrush" />
            <StaticResource x:Key="MenuFlyoutItemKeyboardAcceleratorTextForegroundDisabled"
                            ResourceKey="MqMenuForegroundDisabledBrush" />

            <!-- Submenu rows: Open Recent, Theme. Kept identical to a plain row. -->
            <StaticResource x:Key="MenuFlyoutSubItemForeground" ResourceKey="MqMenuForegroundBrush" />
            <StaticResource x:Key="MenuFlyoutSubItemForegroundPointerOver" ResourceKey="MqMenuForegroundBrush" />
            <StaticResource x:Key="MenuFlyoutSubItemForegroundPressed" ResourceKey="MqMenuForegroundBrush" />
            <StaticResource x:Key="MenuFlyoutSubItemForegroundSubMenuOpened" ResourceKey="MqMenuForegroundBrush" />
            <StaticResource x:Key="MenuFlyoutSubItemForegroundDisabled" ResourceKey="MqMenuForegroundDisabledBrush" />
            <StaticResource x:Key="MenuFlyoutSubItemBackgroundPointerOver" ResourceKey="MqMenuItemHoverBrush" />
            <StaticResource x:Key="MenuFlyoutSubItemBackgroundPressed" ResourceKey="MqMenuItemPressedBrush" />
            <StaticResource x:Key="MenuFlyoutSubItemBackgroundSubMenuOpened" ResourceKey="MqMenuItemHoverBrush" />
            <StaticResource x:Key="MenuFlyoutSubItemChevron" ResourceKey="MqMenuAcceleratorForegroundBrush" />
            <StaticResource x:Key="MenuFlyoutSubItemChevronPointerOver" ResourceKey="MqMenuAcceleratorForegroundBrush" />
            <StaticResource x:Key="MenuFlyoutSubItemChevronPressed" ResourceKey="MqMenuAcceleratorForegroundBrush" />
            <StaticResource x:Key="MenuFlyoutSubItemChevronSubMenuOpened" ResourceKey="MqMenuAcceleratorForegroundBrush" />
            <StaticResource x:Key="MenuFlyoutSubItemChevronDisabled" ResourceKey="MqMenuForegroundDisabledBrush" />

            <!--
                The File / Edit / View titles in the header bar. The bar itself is left
                unpainted: it sits on Mica along with the tab strip, and painting it would
                put a panel where the window chrome should be. See MainWindow.xaml.
            -->
            <StaticResource x:Key="MenuBarItemBackgroundPointerOver" ResourceKey="MqMenuItemHoverBrush" />
            <StaticResource x:Key="MenuBarItemBackgroundPressed" ResourceKey="MqMenuItemPressedBrush" />
            <StaticResource x:Key="MenuBarItemBackgroundSelected" ResourceKey="MqMenuItemHoverBrush" />
        </ResourceDictionary>

        <!-- ============================================================= dark theme -->

        <!--
            Keyed "Default" rather than "Dark", for the reason given in App.xaml: both are
            accepted for the dark theme, but "Default" is the one the framework falls back
            to, so keying it this way cannot leave a lookup unresolved.
        -->
        <ResourceDictionary x:Key="Default">

            <AcrylicBrush x:Key="MqMenuBackgroundBrush"
                          TintColor="#2C2C2C"
                          TintOpacity="0.15"
                          TintLuminosityOpacity="0.96"
                          FallbackColor="#2C2C2C" />

            <SolidColorBrush x:Key="MqMenuBorderBrush" Color="#33000000" />
            <SolidColorBrush x:Key="MqMenuForegroundBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="MqMenuForegroundDisabledBrush" Color="#5DFFFFFF" />
            <SolidColorBrush x:Key="MqMenuAcceleratorForegroundBrush" Color="#C5FFFFFF" />
            <SolidColorBrush x:Key="MqMenuItemHoverBrush" Color="#0FFFFFFF" />
            <SolidColorBrush x:Key="MqMenuItemPressedBrush" Color="#0AFFFFFF" />
            <SolidColorBrush x:Key="MqMenuSeparatorBrush" Color="#15FFFFFF" />

            <StaticResource x:Key="MenuFlyoutPresenterBackground" ResourceKey="MqMenuBackgroundBrush" />
            <StaticResource x:Key="MenuFlyoutPresenterBorderBrush" ResourceKey="MqMenuBorderBrush" />
            <StaticResource x:Key="MenuFlyoutSeparatorThemeBrush" ResourceKey="MqMenuSeparatorBrush" />

            <StaticResource x:Key="MenuFlyoutItemForeground" ResourceKey="MqMenuForegroundBrush" />
            <StaticResource x:Key="MenuFlyoutItemForegroundPointerOver" ResourceKey="MqMenuForegroundBrush" />
            <StaticResource x:Key="MenuFlyoutItemForegroundPressed" ResourceKey="MqMenuForegroundBrush" />
            <StaticResource x:Key="MenuFlyoutItemForegroundDisabled" ResourceKey="MqMenuForegroundDisabledBrush" />

            <StaticResource x:Key="MenuFlyoutItemBackgroundPointerOver" ResourceKey="MqMenuItemHoverBrush" />
            <StaticResource x:Key="MenuFlyoutItemBackgroundPressed" ResourceKey="MqMenuItemPressedBrush" />

            <StaticResource x:Key="MenuFlyoutItemCheckGlyphForeground" ResourceKey="MqMenuForegroundBrush" />
            <StaticResource x:Key="MenuFlyoutItemCheckGlyphForegroundPointerOver" ResourceKey="MqMenuForegroundBrush" />
            <StaticResource x:Key="MenuFlyoutItemCheckGlyphForegroundPressed" ResourceKey="MqMenuForegroundBrush" />
            <StaticResource x:Key="MenuFlyoutItemCheckGlyphForegroundDisabled" ResourceKey="MqMenuForegroundDisabledBrush" />

            <StaticResource x:Key="MenuFlyoutItemKeyboardAcceleratorTextForeground"
                            ResourceKey="MqMenuAcceleratorForegroundBrush" />
            <StaticResource x:Key="MenuFlyoutItemKeyboardAcceleratorTextForegroundPointerOver"
                            ResourceKey="MqMenuAcceleratorForegroundBrush" />
            <StaticResource x:Key="MenuFlyoutItemKeyboardAcceleratorTextForegroundPressed"
                            ResourceKey="MqMenuAcceleratorForegroundBrush" />
            <StaticResource x:Key="MenuFlyoutItemKeyboardAcceleratorTextForegroundDisabled"
                            ResourceKey="MqMenuForegroundDisabledBrush" />

            <StaticResource x:Key="MenuFlyoutSubItemForeground" ResourceKey="MqMenuForegroundBrush" />
            <StaticResource x:Key="MenuFlyoutSubItemForegroundPointerOver" ResourceKey="MqMenuForegroundBrush" />
            <StaticResource x:Key="MenuFlyoutSubItemForegroundPressed" ResourceKey="MqMenuForegroundBrush" />
            <StaticResource x:Key="MenuFlyoutSubItemForegroundSubMenuOpened" ResourceKey="MqMenuForegroundBrush" />
            <StaticResource x:Key="MenuFlyoutSubItemForegroundDisabled" ResourceKey="MqMenuForegroundDisabledBrush" />
            <StaticResource x:Key="MenuFlyoutSubItemBackgroundPointerOver" ResourceKey="MqMenuItemHoverBrush" />
            <StaticResource x:Key="MenuFlyoutSubItemBackgroundPressed" ResourceKey="MqMenuItemPressedBrush" />
            <StaticResource x:Key="MenuFlyoutSubItemBackgroundSubMenuOpened" ResourceKey="MqMenuItemHoverBrush" />
            <StaticResource x:Key="MenuFlyoutSubItemChevron" ResourceKey="MqMenuAcceleratorForegroundBrush" />
            <StaticResource x:Key="MenuFlyoutSubItemChevronPointerOver" ResourceKey="MqMenuAcceleratorForegroundBrush" />
            <StaticResource x:Key="MenuFlyoutSubItemChevronPressed" ResourceKey="MqMenuAcceleratorForegroundBrush" />
            <StaticResource x:Key="MenuFlyoutSubItemChevronSubMenuOpened" ResourceKey="MqMenuAcceleratorForegroundBrush" />
            <StaticResource x:Key="MenuFlyoutSubItemChevronDisabled" ResourceKey="MqMenuForegroundDisabledBrush" />

            <StaticResource x:Key="MenuBarItemBackgroundPointerOver" ResourceKey="MqMenuItemHoverBrush" />
            <StaticResource x:Key="MenuBarItemBackgroundPressed" ResourceKey="MqMenuItemPressedBrush" />
            <StaticResource x:Key="MenuBarItemBackgroundSelected" ResourceKey="MqMenuItemHoverBrush" />
        </ResourceDictionary>

    </ResourceDictionary.ThemeDictionaries>

    <!-- ================================================================== metrics -->

    <!--
        Shape and type, which do not change with the theme. Fluent's own values for a
        Windows 11 menu; edit here and all four menus resize together.
    -->

    <FontFamily x:Key="MqMenuFontFamily">Segoe UI Variable Text</FontFamily>
    <x:Double x:Key="MqMenuFontSize">14</x:Double>

    <!-- Row geometry. A minimum rather than a height, so a long label wraps rather than clips. -->
    <x:Double x:Key="MqMenuItemMinHeight">32</x:Double>
    <Thickness x:Key="MqMenuItemPadding">11,0,11,0</Thickness>

    <!-- The surface: a 4px gutter of background around the rows, and Fluent's 8px corner. -->
    <Thickness x:Key="MqMenuPresenterPadding">4,4,4,4</Thickness>
    <CornerRadius x:Key="MqMenuCornerRadius">8</CornerRadius>
    <Thickness x:Key="MqMenuBorderThickness">1</Thickness>

    <!--
        Width. The floor stops a two-item context menu opening as a sliver; the ceiling
        stops a long recent-files path running to the edge of the screen.
    -->
    <x:Double x:Key="MqMenuMinWidth">180</x:Double>
    <x:Double x:Key="MqMenuMaxWidth">460</x:Double>

    <!-- The rule between groups of items. -->
    <x:Double x:Key="MqMenuSeparatorHeight">1</x:Double>
    <Thickness x:Key="MqMenuSeparatorPadding">0,4,0,4</Thickness>

    <StaticResource x:Key="MenuFlyoutSeparatorThemeHeight" ResourceKey="MqMenuSeparatorHeight" />
    <StaticResource x:Key="MenuFlyoutSeparatorThemePadding" ResourceKey="MqMenuSeparatorPadding" />

    <!-- =================================================================== styles -->

    <!--
        Implicit, so they reach every menu in the app including the ones built in code -
        the recent-files submenu, and the diagram and cheatsheet windows' context menus -
        without any of them naming a style.

        Each is BasedOn the framework's default, which is what keeps the control templates
        intact. An implicit style with no BasedOn replaces the default outright, template
        and all, and a menu item with no template renders as nothing at all.
    -->

    <Style TargetType="MenuFlyoutPresenter" BasedOn="{StaticResource DefaultMenuFlyoutPresenterStyle}">
        <Setter Property="Background" Value="{ThemeResource MqMenuBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource MqMenuBorderBrush}" />
        <Setter Property="BorderThickness" Value="{ThemeResource MqMenuBorderThickness}" />
        <Setter Property="CornerRadius" Value="{ThemeResource MqMenuCornerRadius}" />
        <Setter Property="Padding" Value="{ThemeResource MqMenuPresenterPadding}" />
        <Setter Property="MinWidth" Value="{ThemeResource MqMenuMinWidth}" />
        <Setter Property="MaxWidth" Value="{ThemeResource MqMenuMaxWidth}" />
    </Style>

    <Style TargetType="MenuFlyoutItem" BasedOn="{StaticResource DefaultMenuFlyoutItemStyle}">
        <Setter Property="FontFamily" Value="{ThemeResource MqMenuFontFamily}" />
        <Setter Property="FontSize" Value="{ThemeResource MqMenuFontSize}" />
        <Setter Property="MinHeight" Value="{ThemeResource MqMenuItemMinHeight}" />
        <Setter Property="Padding" Value="{ThemeResource MqMenuItemPadding}" />
    </Style>

    <Style TargetType="ToggleMenuFlyoutItem" BasedOn="{StaticResource DefaultToggleMenuFlyoutItemStyle}">
        <Setter Property="FontFamily" Value="{ThemeResource MqMenuFontFamily}" />
        <Setter Property="FontSize" Value="{ThemeResource MqMenuFontSize}" />
        <Setter Property="MinHeight" Value="{ThemeResource MqMenuItemMinHeight}" />
        <Setter Property="Padding" Value="{ThemeResource MqMenuItemPadding}" />
    </Style>

    <Style TargetType="MenuFlyoutSubItem" BasedOn="{StaticResource DefaultMenuFlyoutSubItemStyle}">
        <Setter Property="FontFamily" Value="{ThemeResource MqMenuFontFamily}" />
        <Setter Property="FontSize" Value="{ThemeResource MqMenuFontSize}" />
        <Setter Property="MinHeight" Value="{ThemeResource MqMenuItemMinHeight}" />
        <Setter Property="Padding" Value="{ThemeResource MqMenuItemPadding}" />
    </Style>

    <!--
        There is deliberately no implicit style for MenuBar or MenuBarItem.

        Neither publishes a default style to build on - MenuBar's exists but is not
        reachable by key, and MenuBarItem has none at all - and an implicit style with no
        BasedOn takes the control template down with it, which for the menu bar means a
        window that will not open. The header bar therefore reads the two font tokens
        directly off its element in MainWindow.xaml, and the titles inherit them. The
        values still live here, which is the point.
    -->

</ResourceDictionary>
