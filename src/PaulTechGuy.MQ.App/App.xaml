<Application
    x:Class="PaulTechGuy.MQ.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />

                <!--
                    Marqora's accent, replacing the one Windows supplies.

                    Scope: the app's own surfaces - accent buttons, focus rings, text
                    selection, the view switcher, the toolbar toggles - and the active tab.
                    The menu bar and the status bar are still left entirely to WinUI and to
                    Mica, which is what a stock Windows 11 app looks like. The tab strip is
                    the one piece of chrome the accent reaches, for the reason given with the
                    tab keys below.

                    This dictionary is merged, and merged AFTER XamlControlsResources, and both
                    of those matter. A ResourceDictionary is searched in the order: its own
                    entries, then its merged dictionaries last-to-first, then its theme
                    dictionaries. Putting these overrides in Application.Resources'
                    ThemeDictionaries - a sibling of MergedDictionaries rather than a member of
                    it - therefore placed them behind XamlControlsResources, so every key the
                    framework also defines resolved to the framework's value, and only
                    Marqora's own Mq* keys, which nothing else defines, ever came through. The
                    accent reached the view switcher, which uses an Mq* key, and never reached
                    anything drawn from a stock key: accent buttons and the scroll-sync toggle
                    stayed the Windows accent colour however many times the keys were rewritten.

                    Merged after XamlControlsResources, these win.

                    Dark theme uses a lighter mix of the same hue, since #51A8B1 is a mid tone
                    and goes muddy against a dark surface. Text sitting on the accent is a
                    near-black teal rather than the usual white: this accent is light enough
                    that white on it falls well below a readable contrast ratio.

                    The dark dictionary is keyed "Default" rather than "Dark". Both are accepted
                    for the dark theme, but "Default" is the one the framework falls back to, so
                    keying it that way cannot leave a lookup unresolved.
                -->
                <ResourceDictionary>
                    <ResourceDictionary.ThemeDictionaries>

                        <ResourceDictionary x:Key="Light">
                            <Color x:Key="MqAccentColor">#FF51A8B1</Color>

                            <!-- Marqora's own keys, referenced directly by Marqora's markup. -->
                            <SolidColorBrush x:Key="MqAccentBrush" Color="#FF51A8B1" />
                            <SolidColorBrush x:Key="MqAccentSoftBrush" Color="#2851A8B1" />
                            <SolidColorBrush x:Key="MqAccentFaintBrush" Color="#1451A8B1" />
                            <SolidColorBrush x:Key="MqOnAccentBrush" Color="#FF04262A" />
                            <SolidColorBrush x:Key="MqAccentTextBrush" Color="#FF2E7C84" />

                            <!--
                                Amber, for the few things that report something the user did
                                not ask for. Marqora's own rather than SystemFillColorCaution:
                                that one moves with the OS, and this has to stay legible
                                against a known text colour at 12px.

                                Dark brown on amber rather than white: 7.8:1, where white on
                                the same amber is 1.9:1 and unreadable. The same near-black is
                                used in both themes so the pair keeps its contrast when the
                                amber lightens for dark mode.
                            -->
                            <SolidColorBrush x:Key="MqWarnBrush" Color="#FFE8A317" />
                            <SolidColorBrush x:Key="MqOnWarnBrush" Color="#FF2B1A00" />

                            <!-- Accent-derived stock keys. -->
                            <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#FF51A8B1" />
                            <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#E651A8B1" />
                            <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#CC51A8B1" />
                            <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#FF2E7C84" />
                            <SolidColorBrush x:Key="AccentTextFillColorSecondaryBrush" Color="#FF276B72" />
                            <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#FF04262A" />
                            <SolidColorBrush x:Key="TextOnAccentFillColorSecondaryBrush" Color="#CC04262A" />

                            <!-- Toolbar toggles, which read as accent when they are on. -->
                            <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="#FF51A8B1" />
                            <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="#FF469AA3" />
                            <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="#FF3D8B93" />
                            <SolidColorBrush x:Key="ToggleButtonForegroundChecked" Color="#FF04262A" />
                            <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPointerOver" Color="#FF04262A" />
                            <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPressed" Color="#FF04262A" />

                            <!--
                                The active tab.

                                The stock selected tab differs from its neighbours only by an
                                almost unpainted plate, and under Mica that difference is very
                                nearly invisible: the one thing on the strip that has to be
                                readable at a glance was the hardest thing on it to see. So
                                the tab strip is the one piece of chrome the accent reaches.

                                Brushes only - no thickness, padding or size keys.
                                UpdateTabTitles books each tab's chrome from TabView's own
                                template metrics (ClosableTabChrome in MainWindow.xaml.cs,
                                which includes the 1px border), and the strip cannot scroll,
                                so anything that changes a tab's measured width silently
                                falsifies the fit pass and clips the last tab. Colour cannot
                                move a pixel - measuring the strip since confirms the border
                                is 1px in both states, so the accent edge below is free.

                                The signal is pushed from both ends: the active tab gains an
                                accent-tinted plate, an accent edge and full-strength text,
                                while the inactive ones sit at secondary. Text on the plate is
                                a near-black teal rather than the accent - accent on accent is
                                the one pairing here that fails contrast outright.
                            -->
                            <SolidColorBrush x:Key="TabViewItemHeaderBackgroundSelected" Color="#FFD5EBEE" />
                            <SolidColorBrush x:Key="TabViewItemHeaderForegroundSelected" Color="#FF0F2C30" />
                            <SolidColorBrush x:Key="TabViewSelectedItemBorderBrush" Color="#FF51A8B1" />
                            <SolidColorBrush x:Key="TabViewItemHeaderSelectedCloseButtonForeground" Color="#FF0F2C30" />

                            <SolidColorBrush x:Key="TabViewItemHeaderForeground" Color="#9E000000" />
                            <SolidColorBrush x:Key="TabViewItemHeaderCloseButtonForeground" Color="#9E000000" />
                            <SolidColorBrush x:Key="TabViewItemHeaderForegroundPointerOver" Color="#E4000000" />
                            <SolidColorBrush x:Key="TabViewItemHeaderBackgroundPointerOver" Color="#1F51A8B1" />
                            <SolidColorBrush x:Key="TabViewItemHeaderBackgroundPressed" Color="#3351A8B1" />

                            <!--
                                The chrome rules: the hairline under the tab strip, under the
                                menu bar and under the format bar, the one over the status bar,
                                and the short vertical bars that group the format toolbar.

                                Stock, these are CardStrokeColorDefault and
                                DividerStrokeColorDefault - both 6% black in this theme, and in
                                dark CardStrokeColorDefault is 10% *black*, which is a shadow
                                edge meant to sit under a raised card rather than a divider
                                drawn on a flat surface. Neither has much to work against on an
                                unpainted row: the chrome here is left to Mica, so the backdrop
                                is translucent and takes its tint from the desktop, and whatever
                                contrast the line had varied with the wallpaper behind the
                                window.

                                Marqora's own keys rather than an override of the stock ones,
                                because CardStrokeColorDefaultBrush is also on the empty-state
                                drop target, where a barely-there card edge is exactly right.

                                TabViewBorderBrush has to be restated even though stock aliases
                                it to CardStrokeColorDefault. That alias is a StaticResource,
                                resolved once inside the framework dictionary, so rewriting the
                                colour here would never reach the line TabView draws along the
                                foot of the strip - and that line sits a few pixels above the
                                menu bar's own, where any mismatch between the two is obvious.
                            -->
                            <SolidColorBrush x:Key="MqChromeRuleBrush" Color="#36000000" />
                            <SolidColorBrush x:Key="MqChromeDividerBrush" Color="#32000000" />
                            <SolidColorBrush x:Key="TabViewBorderBrush" Color="#36000000" />
                        </ResourceDictionary>

                        <ResourceDictionary x:Key="Default">
                            <Color x:Key="MqAccentColor">#FF63BCC5</Color>

                            <SolidColorBrush x:Key="MqAccentBrush" Color="#FF63BCC5" />
                            <SolidColorBrush x:Key="MqAccentSoftBrush" Color="#3363BCC5" />
                            <SolidColorBrush x:Key="MqAccentFaintBrush" Color="#1E63BCC5" />
                            <SolidColorBrush x:Key="MqOnAccentBrush" Color="#FF04262A" />
                            <SolidColorBrush x:Key="MqAccentTextBrush" Color="#FF7FCDD5" />

                            <!-- Lifted a little for dark mode, as the accent is. 9.1:1. -->
                            <SolidColorBrush x:Key="MqWarnBrush" Color="#FFF2B434" />
                            <SolidColorBrush x:Key="MqOnWarnBrush" Color="#FF2B1A00" />

                            <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#FF63BCC5" />
                            <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#E663BCC5" />
                            <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#CC63BCC5" />
                            <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#FF7FCDD5" />
                            <SolidColorBrush x:Key="AccentTextFillColorSecondaryBrush" Color="#FF6FC3CC" />
                            <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#FF04262A" />
                            <SolidColorBrush x:Key="TextOnAccentFillColorSecondaryBrush" Color="#CC04262A" />

                            <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="#FF63BCC5" />
                            <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="#FF74C6CE" />
                            <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="#FF55AEB7" />
                            <SolidColorBrush x:Key="ToggleButtonForegroundChecked" Color="#FF04262A" />
                            <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPointerOver" Color="#FF04262A" />
                            <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPressed" Color="#FF04262A" />

                            <!--
                                The active tab - see the Light dictionary for why the strip is
                                painted at all and why this is brushes only. The plate is a
                                deep teal rather than a pale one: the same tint that lifts off
                                a white page would be lost against a dark strip.
                            -->
                            <SolidColorBrush x:Key="TabViewItemHeaderBackgroundSelected" Color="#FF1D4A50" />
                            <SolidColorBrush x:Key="TabViewItemHeaderForegroundSelected" Color="#FFEAF7F9" />
                            <SolidColorBrush x:Key="TabViewSelectedItemBorderBrush" Color="#FF63BCC5" />
                            <SolidColorBrush x:Key="TabViewItemHeaderSelectedCloseButtonForeground" Color="#FFEAF7F9" />

                            <SolidColorBrush x:Key="TabViewItemHeaderForeground" Color="#C5FFFFFF" />
                            <SolidColorBrush x:Key="TabViewItemHeaderCloseButtonForeground" Color="#C5FFFFFF" />
                            <SolidColorBrush x:Key="TabViewItemHeaderForegroundPointerOver" Color="#FFFFFFFF" />
                            <SolidColorBrush x:Key="TabViewItemHeaderBackgroundPointerOver" Color="#2663BCC5" />
                            <SolidColorBrush x:Key="TabViewItemHeaderBackgroundPressed" Color="#3D63BCC5" />

                            <!--
                                The chrome rules - see the Light dictionary for what these are
                                and why they are Marqora's own keys. White rather than black
                                here: the stock rule is 10% black on a dark row, which is the
                                whole of why the dividers were hardest to find in this theme.
                            -->
                            <SolidColorBrush x:Key="MqChromeRuleBrush" Color="#30FFFFFF" />
                            <SolidColorBrush x:Key="MqChromeDividerBrush" Color="#2CFFFFFF" />
                            <SolidColorBrush x:Key="TabViewBorderBrush" Color="#30FFFFFF" />
                        </ResourceDictionary>

                    </ResourceDictionary.ThemeDictionaries>
                </ResourceDictionary>

                <!--
                    Every menu in the app - the header bar, both context menus and the ones
                    the diagram and cheatsheet windows build in code - takes its font,
                    spacing and colours from this one dictionary. Merged last for the same
                    reason as the accent above: a dictionary merged after
                    XamlControlsResources wins, one merged before it does not.
                -->
                <ResourceDictionary Source="Themes/Menus.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Shared metrics, so spacing stays consistent across the chrome. -->
            <x:Double x:Key="MqToolbarHeight">48</x:Double>
            <!--
                Shorter than the chrome row above it. The buttons are 34 tall either way,
                and four stacked strips over a 420-pixel minimum window height is already
                most of what a small window has to give.
            -->
            <x:Double x:Key="MqFormatBarHeight">40</x:Double>

            <!--
                Tabs take their natural width up to this cap; a longer name is shortened
                from the middle to fit it rather than widening the tab. Short names stay
                short, long ones all stop at the same place.
            -->
            <x:Double x:Key="TabViewItemMaxWidth">220</x:Double>

            <!--
                The tab's tooltip is the only place the full path is shown, and WinUI's stock
                320 wrapped most of them onto a second line mid-folder. Widening the cap by
                30% keeps a typical path on one line without letting a deep one run the width
                of the screen. The key is the framework's own, so every tooltip in the app
                takes it - which is the point: the tab list menu and the recent files list
                show the same paths.
            -->
            <x:Double x:Key="ToolTipContentMaxWidth">416</x:Double>

            <x:Double x:Key="MqTitleBarHeight">44</x:Double>
            <x:Double x:Key="MqTabStripHeight">40</x:Double>
            <Thickness x:Key="MqToolbarPadding">10,0,10,0</Thickness>
            <CornerRadius x:Key="MqPillRadius">6</CornerRadius>

            <!--
                A quiet toolbar button: no chrome until the pointer arrives. Keeps the
                command bar visually calm while remaining a full-size hit target.
            -->
            <Style x:Key="MqToolButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="10,6" />
                <Setter Property="MinWidth" Value="36" />
                <Setter Property="Height" Value="34" />
                <Setter Property="CornerRadius" Value="{StaticResource MqPillRadius}" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="FontSize" Value="13" />
            </Style>

            <Style x:Key="MqToolToggleStyle" TargetType="ToggleButton">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="10,6" />
                <Setter Property="MinWidth" Value="36" />
                <Setter Property="Height" Value="34" />
                <Setter Property="CornerRadius" Value="{StaticResource MqPillRadius}" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="FontSize" Value="13" />
            </Style>

            <!--
                The folder line under a recent file's name. It reads as the plain caption it
                has always been and only grows a hit target once the pointer is on it, so the
                card stays quiet while the path stays clickable.
            -->
            <Style x:Key="MqPathLinkStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="5,1" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="HorizontalAlignment" Value="Left" />
                <!-- Cancels the padding, so the path keeps its left edge under the file name. -->
                <Setter Property="Margin" Value="-5,0,0,0" />
            </Style>

            <Style x:Key="MqDropDownStyle" TargetType="DropDownButton">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="10,6" />
                <Setter Property="Height" Value="34" />
                <Setter Property="CornerRadius" Value="{StaticResource MqPillRadius}" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="FontSize" Value="13" />
            </Style>

            <!--
                Segmented view switcher: the three buttons read as one control.

                This carries its own template rather than restyling the stock one, and the
                reason is text quality. The default ToggleButton animates on press and on
                check, and while an animation runs the control's content is composited into
                its own layer - which drops the label from ClearType to grayscale
                antialiasing. The text visibly softens and only sharpens again once the
                layer is discarded, which on these three buttons was the whole of the
                blurry-label problem. The template below changes state by swapping brushes,
                so no layer is ever created and the labels stay sharp.
            -->
            <Style x:Key="MqSegmentStyle" TargetType="ToggleButton">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="5" />
                <Setter Property="Padding" Value="14,5" />
                <Setter Property="Height" Value="30" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="FontSize" Value="12.5" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Grid x:Name="Root"
                                  Background="{TemplateBinding Background}"
                                  CornerRadius="{TemplateBinding CornerRadius}"
                                  Padding="{TemplateBinding Padding}">

                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />

                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="Root.Background"
                                                        Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>

                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="Root.Background"
                                                        Value="{ThemeResource SubtleFillColorTertiaryBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>

                                        <VisualState x:Name="Disabled">
                                            <VisualState.Setters>
                                                <Setter Target="Label.Foreground"
                                                        Value="{ThemeResource TextFillColorDisabledBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>

                                        <VisualState x:Name="Checked">
                                            <VisualState.Setters>
                                                <Setter Target="Root.Background"
                                                        Value="{ThemeResource MqAccentBrush}" />
                                                <Setter Target="Label.Foreground"
                                                        Value="{ThemeResource MqOnAccentBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>

                                        <VisualState x:Name="CheckedPointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="Root.Background"
                                                        Value="{ThemeResource MqAccentBrush}" />
                                                <Setter Target="Label.Foreground"
                                                        Value="{ThemeResource MqOnAccentBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>

                                        <VisualState x:Name="CheckedPressed">
                                            <VisualState.Setters>
                                                <Setter Target="Root.Background"
                                                        Value="{ThemeResource MqAccentBrush}" />
                                                <Setter Target="Label.Foreground"
                                                        Value="{ThemeResource MqOnAccentBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>

                                        <VisualState x:Name="CheckedDisabled">
                                            <VisualState.Setters>
                                                <Setter Target="Root.Background"
                                                        Value="{ThemeResource AccentFillColorDisabledBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>

                                <ContentPresenter x:Name="Label"
                                                  Content="{TemplateBinding Content}"
                                                  Foreground="{TemplateBinding Foreground}"
                                                  FontSize="{TemplateBinding FontSize}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="MqIconStyle" TargetType="FontIcon">
                <Setter Property="FontSize" Value="15" />
                <Setter Property="FontFamily" Value="{ThemeResource SymbolThemeFontFamily}" />
            </Style>

            <Style x:Key="MqCaptionTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

        </ResourceDictionary>
    </Application.Resources>

</Application>
