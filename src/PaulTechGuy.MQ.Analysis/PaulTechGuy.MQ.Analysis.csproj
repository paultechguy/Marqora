<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Document checks: links that lead nowhere, images that are not there, and the handful of
    style rules that can be reported without rewriting anything. Text and a parsed link list
    in, diagnostics out. It touches the filesystem only to ask whether a file exists, so it
    tests cleanly against a temporary folder.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>PaulTechGuy.MQ.Analysis</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PaulTechGuy.MQ.Abstractions\PaulTechGuy.MQ.Abstractions.csproj" />
    <ProjectReference Include="..\PaulTechGuy.MQ.Domain\PaulTechGuy.MQ.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>

</Project>
