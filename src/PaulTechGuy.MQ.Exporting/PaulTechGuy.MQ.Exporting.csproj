<Project Sdk="Microsoft.NET.Sdk">

  <!--
    What turns a document into something that leaves the app - page assembly, packaging, the Folio's
    HTML, the export jobs - shared by the app and marqora-cli, so an export cannot differ between
    them (docs/CLI-Implementation-Plan.md, CLI-ARC-01 and CLI-ARC-02).

    Plain net10.0 on purpose: nothing here may reach WinUI or Windows, and the target framework is
    what holds it to that. What needs Windows - resizing a picture - is handed in through an
    Abstractions contract.

    Created in M1 with FolioShrinker alone, for the Folio's "Shrink images wider than". The page
    assembly and packaging moved in with WP-M2-02: HtmlExporter, HtmlPageLayout, FolioHtmlWriter,
    DiagramHtmlDocument, ColorThemePayloads, DiagramViewer and RenderedHtmlPackager.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>PaulTechGuy.MQ.Exporting</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PaulTechGuy.MQ.Abstractions\PaulTechGuy.MQ.Abstractions.csproj" />
    <ProjectReference Include="..\PaulTechGuy.MQ.Domain\PaulTechGuy.MQ.Domain.csproj" />
    <ProjectReference Include="..\PaulTechGuy.MQ.Folio\PaulTechGuy.MQ.Folio.csproj" />
    <ProjectReference Include="..\PaulTechGuy.MQ.Themes\PaulTechGuy.MQ.Themes.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

</Project>
