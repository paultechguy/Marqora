<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The preview shell in a WebView2 that is never shown: what marqora-cli renders and prints
    with, and in time the app's Word export too (docs/CLI-Implementation-Plan.md, WP-M0-01).
    And the paged engine both of them print with (PagedPrintHost, PagedJobs, WebViewPrinting),
    moved here from the app in WP-M2-03 and told once, by the app or the CLI, which browser to
    run in.

    WebView2 Core only, no WinUI. The paged engine is written against WebView2's WinRT
    projection, which the package switches on by itself only for Windows App SDK projects, so it
    is asked for here by name. With it the package copies the native WinRT component beside the
    executable, and C#/WinRT activates it from there with no registration.

    x64 named outright: the package picks the native component's architecture from the platform
    target, and AnyCPU would hand the executable an x86 copy under the same file name.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>PaulTechGuy.MQ.WebRender</RootNamespace>
    <PlatformTarget>x64</PlatformTarget>
    <WebView2EnableCsWinRTProjection>true</WebView2EnableCsWinRTProjection>

    <!-- LibraryImport generates its marshalling as unsafe code. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PaulTechGuy.MQ.Abstractions\PaulTechGuy.MQ.Abstractions.csproj" />
    <ProjectReference Include="..\PaulTechGuy.MQ.Domain\PaulTechGuy.MQ.Domain.csproj" />
    <ProjectReference Include="..\PaulTechGuy.MQ.Exporting\PaulTechGuy.MQ.Exporting.csproj" />
    <ProjectReference Include="..\PaulTechGuy.MQ.Themes\PaulTechGuy.MQ.Themes.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

</Project>
